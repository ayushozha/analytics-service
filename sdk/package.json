{
  "name": "@ayushojha/pulse-analytics",
  "version": "0.1.0",
  "description": "Lightweight analytics SDK for Pulse Analytics",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "analytics",
    "tracking",
    "pageview",
    "events",
    "self-hosted"
  ],
  "author": "Ayush Ojha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ayush10/pulse-analytics"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
