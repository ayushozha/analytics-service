# Server
PULSE_PORT=8090
ENVIRONMENT=development
RUST_LOG=info

# PostgreSQL
DATABASE_URL=postgres://admin:password@localhost:5433/pulse_analytics?sslmode=disable

# Redis
REDIS_URL=redis://pulse_analytics_user:password@localhost:6380/0
REDIS_KEY_PREFIX=pulse_analytics:

# Admin
PULSE_ADMIN_TOKEN=change-me-to-a-secure-token

# BI external-DB connection encryption (optional but recommended in production).
# 32-byte AES-256-GCM key, base64-encoded. Encrypts bi_database_connections.connection_string
# at rest. Generate with:  openssl rand -base64 32
# If unset or empty, connection strings are stored verbatim (legacy behavior). If set,
# the server fails startup unless this decodes to exactly 32 bytes. Rotating this key
# makes existing encrypted connection strings unreadable, so re-enter them after a rotation.
BI_CONNECTION_KMS_KEY=

# Umami (optional - for proxying Umami data)
UMAMI_URL=https://analytics.ayushojha.com
UMAMI_USER=admin
UMAMI_PASS=your-umami-password

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://ayushojha.com

# GeoIP (optional - download from MaxMind)
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Buffer settings
BUFFER_FLUSH_INTERVAL_SECS=5
BUFFER_BATCH_SIZE=500
RATE_LIMIT_PER_SECOND=100
